# Configuration clipforge
# Copiez ce fichier en .env et adaptez les valeurs

# LLM
CLIPFORGE_LLM_PROVIDER=none
CLIPFORGE_GEMINI_API_KEY=
CLIPFORGE_GEMINI_MODEL=gemini-1.5-flash
CLIPFORGE_OLLAMA_BASE_URL=http://localhost:11434
CLIPFORGE_OLLAMA_MODEL=llama3.2

# Whisper
CLIPFORGE_WHISPER_MODEL=base
CLIPFORGE_WHISPER_DEVICE=auto

# Recadrage
CLIPFORGE_CROP_TARGET_ASPECT=9:16
CLIPFORGE_CROP_TARGET_WIDTH=1080
CLIPFORGE_CROP_TARGET_HEIGHT=1920
CLIPFORGE_FACE_DETECTION_INTERVAL=0.5

# Rendu
CLIPFORGE_OUTPUT_FORMAT=mp4
CLIPFORGE_OUTPUT_CODEC=libx264
CLIPFORGE_OUTPUT_PRESET=medium
CLIPFORGE_OUTPUT_CRF=23

# Logging
CLIPFORGE_LOG_LEVEL=INFO
